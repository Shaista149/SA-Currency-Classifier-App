<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F6F5F0">

    <!-- Custom ring logo -->
    <com.example.sacurrencyclassifier.RingLogoView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SA Currency Classifier"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="South African banknotes &amp; coins"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="36dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT MODE"
        android:textSize="10sp"
        android:letterSpacing="0.15"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotes"
            style="@style/GreenToggleButton"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="Banknotes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCoins"
            style="@style/GreenToggleButton"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="Coins" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/tvModeDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <!-- Buttons separate, no shared container -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCamera"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="Take Photo"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/green_primary"
        app:icon="@drawable/ic_camera"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGallery"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="Choose from Gallery"
        android:textSize="14sp"
        android:textColor="@color/green_primary"
        app:strokeColor="@color/green_primary"
        app:icon="@drawable/ic_gallery"
        app:iconGravity="textStart"
        app:iconTint="@color/green_primary" />

</LinearLayout>