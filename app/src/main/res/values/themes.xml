<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SACurrencyClassifier" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="android:statusBarColor">@color/colorPrimaryVariant</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>
    <style name="GreenToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_button_bg</item>
        <item name="android:textColor">@color/toggle_button_text</item>
        <item name="strokeColor">@color/green_primary</item>
    </style>
    <style name="Theme.SACurrencyClassifier.Splash" parent="Theme.SACurrencyClassifier">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
